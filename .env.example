# Copy to .env and adjust. .env is git-ignored.

# Base URL of the API under test
BASE_URL=http://localhost:3001
API_PREFIX=/api

# true  = the test run starts the API in-process on BASE_URL's port (fresh seed data every run)
# false = test an API that is already running at BASE_URL (restart it between runs: checkout consumes stock)
START_SERVER=true

# Must match the server's JWT secret (src/middleware/auth.js default)
JWT_SECRET=workshop-secret-key

# Test user passwords (README test data)
ALICE_PASSWORD=alice123
BOB_PASSWORD=bob123
CAROL_PASSWORD=carol123
